# Copy to fly.toml and change `app`. Full steps: docs/deploying.md#flyio
#
# The listener makes only outbound connections (Discord Gateway, Letta API), so
# this config exposes no public service. The health check below runs inside
# Fly's network and is used for monitoring, not routing.

app = "letta-discord-listener"
primary_region = "iad"

# The listener needs up to 15s to cancel pending approvals and close sessions.
kill_signal = "SIGTERM"
kill_timeout = "30s"

[build]
  dockerfile = "Dockerfile"

[env]
  DATA_DIR = "/app/data"
  HEALTH_PORT = "8080"
  LOG_LEVEL = "info"

# Keep exactly one Machine. A second one would open a second Gateway session for
# the same bot token and reply twice. With a volume attached, the default
# `rolling` strategy replaces the single Machine in place, so deploys never
# overlap (canary and bluegreen are unavailable with volumes anyway).
[deploy]
  strategy = "rolling"

[[mounts]]
  source = "listener_data"
  destination = "/app/data"

[checks]
  [checks.healthz]
    type = "http"
    port = 8080
    method = "get"
    path = "/healthz"
    grace_period = "30s"
    interval = "30s"
    timeout = "5s"

[[restart]]
  policy = "always"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
