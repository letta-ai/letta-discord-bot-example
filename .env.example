# Copy to .env and fill in. Every key below maps to ConfigSchema in src/config.ts.
# The value shown is the default the process uses when the key is absent.
# Empty is accepted for CSV, integer, boolean and free text keys.
# The enum and URL keys (LETTA_BASE_URL, TOOLSET_BASE, PERMISSION_MODE, APPROVAL_MODE,
# DM_POLICY, LOG_LEVEL) must be either a valid value or left commented out, an empty
# value fails validation on startup.

# ---------------------------------------------------------------- credentials
# Required. Bot token from the Discord developer portal.
DISCORD_BOT_TOKEN=
# Required. Letta API key (cloud, or your own deployment).
LETTA_API_KEY=
# Required. Target agent, must look like agent-...
LETTA_AGENT_ID=
# Optional. Letta API base URL for a self hosted Letta. Leave unset, do not set it empty.
# LETTA_BASE_URL=

# ------------------------------------------------------------ execution target
# Optional. Empty means an SDK-managed Cloud sandbox per conversation.
# Set to a custom sandbox/computer target only if you run your own.
LETTA_COMPUTER=
# Idle lifetime of each conversation sandbox, in minutes.
SANDBOX_TTL_MINUTES=30

# --------------------------------------------------------------- agent policy
# Tool permission posture handed to every session: strict | standard | acceptEdits | unrestricted.
PERMISSION_MODE=standard
# CSV allowlist. Empty means the harness default toolset.
ALLOWED_TOOLS=
# Base toolset name: auto | default | codex | gemini | none. Leave unset to let the SDK decide.
# TOOLSET_BASE=auto
# Optional. Pins the model when a conversation is created.
CONVERSATION_MODEL=
# Who approves tool calls: deny | admins | requester | allow.
APPROVAL_MODE=admins
# How long an approval button stays clickable before the call is denied, in seconds.
APPROVAL_TIMEOUT_SECONDS=300
# Longest a whole turn may run, approval waits included (must exceed the approval timeout).
TURN_TIMEOUT_SECONDS=900
# Set to false to strip the listener-owned Discord tools from the agent.
ENABLE_DISCORD_TOOLS=true

# -------------------------------------------------------------- discord gating
# CSV guild ids. Empty means any guild the bot has been invited to.
DISCORD_GUILD_IDS=
# CSV channel ids. Empty means any channel.
DISCORD_CHANNEL_IDS=
# CSV channel ids where the bot replies to every message without needing a mention.
DISCORD_OPEN_CHANNEL_IDS=
# relay: every reply in an open channel is posted. tool: the agent speaks only through
# discord_send_message, so it can stay silent. Other channels, threads, and DMs always relay.
OPEN_CHANNEL_REPLY_MODE=relay
# CSV user ids allowed to use the bot. In servers, empty means everyone; once set, only
# these users and admins are answered. Also the DM allowlist (DM_POLICY=allowlist),
# where empty means admins only.
DISCORD_ALLOWED_USER_IDS=
# CSV user ids that count as admins for approvals and /status details.
DISCORD_ADMIN_USER_IDS=
# CSV role ids that count as admins for approvals and /status details.
DISCORD_ADMIN_ROLE_IDS=
# Direct message handling: off | allowlist | open.
DM_POLICY=allowlist
# Set to true to also answer messages posted by other bots.
RESPOND_TO_BOTS=false
# Create a public thread from the triggering message when addressed in a normal channel
# (channels in DISCORD_OPEN_CHANNEL_IDS never auto-thread).
AUTO_THREAD=true
# Register the /new /cancel /status /help slash commands on startup.
REGISTER_SLASH_COMMANDS=true

# --------------------------------------------------------------------------- ux
# Stream the reply by editing one message instead of posting once at the end.
STREAM_EDITS=false
# Minimum milliseconds between streaming edits.
STREAM_EDIT_INTERVAL_MS=1200
# Show a single in-place status line for tool calls.
SHOW_TOOL_STATUS=true
# Stream model reasoning summaries as a separate message.
SHOW_REASONING=false
# React to the triggering message when a turn succeeds (✅), fails (❌) or is cancelled (⏹️).
LIFECYCLE_REACTIONS=false
# Wait this long for more messages and merge them into one turn.
DEBOUNCE_MS=1500
# Largest inline image, in bytes (5 MiB).
MAX_IMAGE_BYTES=5242880
# Largest uploaded file, in bytes (25 MiB).
MAX_FILE_BYTES=26214400
# Save attachments here when LETTA_COMPUTER shares this filesystem (no managed sandbox).
# LOCAL_ATTACHMENT_DIR=/root/downloads/discord

# ---------------------------------------------------------------- transcription
# none | openai | groq | mistral | together | deepgram | assemblyai | elevenlabs | gemini | openai-compatible
TRANSCRIBE_PROVIDER=none
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=
# Required for openai-compatible (e.g. Speaches http://localhost:8000/v1).
# TRANSCRIBE_BASE_URL=
# TRANSCRIBE_LANGUAGE=en
# TRANSCRIBE_TIMEOUT_SECONDS=60

# ----------------------------------------------------------------------- runtime
# Where the route to conversation index is written. Mount this as a volume.
DATA_DIR=./data
# Port for GET /healthz.
HEALTH_PORT=8080
# Close an idle Letta session after this many minutes. The conversation is kept.
SESSION_IDLE_MINUTES=15
# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info