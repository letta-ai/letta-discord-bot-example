# Copy to /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now letta-discord-listener
# Settings live in /etc/letta-discord-listener.env (same keys as .env.example).
[Unit]
Description=Letta Discord listener
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=letta-discord
Group=letta-discord
WorkingDirectory=/opt/letta-discord-listener
EnvironmentFile=/etc/letta-discord-listener.env
Environment=NODE_ENV=production
# systemd creates /var/lib/letta-discord-listener owned by the service user.
# DATA_DIR is set on the command line so a DATA_DIR in the env file (the example
# has ./data, which is read-only here) cannot override it.
StateDirectory=letta-discord-listener
ExecStart=/usr/bin/env DATA_DIR=/var/lib/letta-discord-listener /usr/local/bin/bun run src/index.ts
Restart=always
RestartSec=5
# The listener needs up to 15s to cancel pending approvals and close sessions.
TimeoutStopSec=30

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
